#!name=腾讯视频去广告
#!desc=去除腾讯视频开屏广告、Wuji广告、富媒体广告
#!homepage=https://github.com/JY-Mar/PxyRes
#!author=RuCu6,JY-Mar
#!tag=Tencent,腾讯,TencentVideo,腾讯视频,去广告
#!date=2026-10-29 14:46:06 GMT+8
#!icon=https://jy-mar.github.io/PxyIco/App/TencentVideo.png
#!openUrl=https://apps.apple.com/app/id458318329
#!loon_version=3.5.1(978)

[Rule]
DOMAIN,adsmind.gdtimg.com,REJECT
DOMAIN,info4.video.qq.com,REJECT
DOMAIN,info6.video.qq.com,REJECT
DOMAIN,ios.video.mpush.qq.com,REJECT
DOMAIN,otheve.beacon.qq.com,REJECT
DOMAIN,pgdt.gtimg.cn,REJECT
DOMAIN,tpns.qq.com,REJECT
DOMAIN,vv6.video.qq.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,l.qq.com,REJECT
DOMAIN-KEYWORD,trace.qq.com,REJECT
DOMAIN-KEYWORD,trace.video.qq.com,REJECT
IP-CIDR,47.110.187.87/32,REJECT,no-resolve
OR,((DOMAIN,pgdt.gtimg.cn),(AND,((USER-AGENT,live4iphoneRel*),(IP-CIDR,0.0.0.0/0,no-resolve)))),REJECT
URL-REGEX,^http:\/\/[\d\.:]*\/?(defaultts\.tc|vmind\.qqvideo\.tc|finderpdd\.video)\.qq\.com\/\w+,REJECT
URL-REGEX,^http:\/\/apd-vlive\.apdcdn\.tc\.qq\.com\/vmind\.qqvideo\.tc\.qq\.com\/\w+,REJECT
URL-REGEX,^http:\/\/apd-\w+\.v\.smtcdns\.com\/(defaultts|omts|vmind\.qqvideo)\.tc\.qq\.com\/\w+,REJECT
DOMAIN,ap-guangzhou.cls.tencentcs.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/vv\.video\.qq\.com\/(diff|get)vmind/i then reject_dict(200)

[Script]
request if ${url} ~= /^https?:\/\/vv\.video\.qq\.com\/getvinfo/i then script("https://jy-mar.github.io/PxyScr/replace-body.js", "sppreviewtype=\\d*>>->>sppreviewtype=0丨spsrt=\\d*>>->>spsrt=0") with tag="移除视频片前广告", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/richmedia\.video\.qq\.com\/get_rich_media_info/i then script("https://jy-mar.github.io/PxyScr/TencentVideo/remove_richmedia_ads.js") with tag="移除富媒体广告", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/cache\.wuji\.qq\.com\/x\/api\/wuji_cache\/object/i then script("https://jy-mar.github.io/PxyScr/TencentVideo/remove_wuji_ads.js") with tag="移除无极广告", timeout=20, requires_body=true

[MITM]
hostname = vv.video.qq.com, richmedia.video.qq.com, cache.wuji.qq.com
