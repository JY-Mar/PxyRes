#!name=360智慧生活去广告
#!desc=移除开屏广告、首页推广横幅、商城入口、我的页面推广、悬浮AI助手
#!homepage=https://github.com/JY-Mar/PxyRes
#!author=可莉🅥,JY-Mar
#!tag=360,360智慧生活,去广告
#!date=2026-10-29 14:45:42 GMT+8
#!icon=https://jy-mar.github.io/PxyIco/App/SmartLife360.png
#!openUrl=https://apps.apple.com/app/id1488904375
#!loon_version=3.5.1(978)

[Rule]
DOMAIN,ad.iot.360.cn,REJECT
DOMAIN,ad.life.360.cn,REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/app\.home\.360\.cn\/v1\/config\/custom_config/i then reject_dict(200)
request if ${url} ~= /^https:\/\/app\.home\.360\.cn\/v1\/push_assist\/get_message/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/app\.home\.360\.cn\/v1\/voice_assistant\/get_entrance/i then script("https://jy-mar.github.io/PxyScr/SmartLife360/remove_assist.js") with tag="移除AI助手", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/jia\.360\.cn\/conf\/v1\.json/i then script("https://jy-mar.github.io/PxyScr/SmartLife360/remove_banner_ads.js") with tag="移除推广横幅广告", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/ota5\.jia\.360\.cn\/upgrade\/getNewVersion/i then script("https://jy-mar.github.io/PxyScr/SmartLife360/remove_app_upgrade.js") with tag="移除应用升级", timeout=20, requires_body=true

[MITM]
hostname = app.home.360.cn, *jia.360.cn
