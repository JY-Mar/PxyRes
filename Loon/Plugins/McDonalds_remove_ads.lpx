[Script]
response if ${url} ~= /^https?:\/\/api\.mcd\.cn\/bff\/portal\/home\/tabBar/i then script("https://jy-mar.github.io/PxyScr/McDonald/remove_tabs.js") with tag="精简Tab栏", timeout=20, requires_body=true

[MITM]
hostname = api.mcd.cn
