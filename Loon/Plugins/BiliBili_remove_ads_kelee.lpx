#!name=哔哩哔哩去广告
#!desc=过滤哔哩哔哩广告、移除青少年模式弹窗和交互式弹幕、移除无用功能和链接跟踪参数，增加空降助手以便跳过视频中插入的广告。此插件仅建议iOS 15以上设备使用，且必须启用MitM-over-HTTP/2功能。\n空降助手是第三方提供的功能，依赖于Android版空降助手的服务器数据运作，可能会存在不准确或者失效的问题，此功能与哔哩哔哩官方无关。
#!homepage=https://github.com/JY-Mar/PxyRes
#!author=kokoryh,可莉🅥,JY-Mar
#!tag=BiliBili,哔哩哔哩,去广告
#!date=2026-11-06 13:57:24 GMT+8
#!icon=https://jy-mar.github.io/PxyIco/App/BiliBili.png
#!openUrl=https://apps.apple.com/app/id736536022
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.5.1(998)

[Argument]
displayUpList = select,"hide","show","auto",type=string,tag=[动态]中[最常访问]的显示方式,desc=auto：仅当列表中存在直播状态时显示；show：始终显示；hide：始终隐藏。
purifyComment = switch,true,type=boolean,tag=移除评论区置顶广告,desc=移除评论区置顶广告
optimizeRequest = switch,true,type=boolean,tag=优化评论区加载异常,desc=尝试解决评论区加载异常的问题
sponsorBlock = switch,true,type=boolean,tag=空降助手,desc=用于跳过视频中的广告
logLevel = select,"off","error","warn","info","debug",type=string,tag=空降助手,desc=脚本的日志输出等级

[Rule]
DOMAIN,bsbsb.top,PROXY
DOMAIN,api.biliapi.com,REJECT
DOMAIN,app.biliapi.com,REJECT
DOMAIN,api.biliapi.net,REJECT
DOMAIN,app.biliapi.net,REJECT
AND,((DOMAIN-SUFFIX, chat.bilibili.com), (OR, ((DOMAIN-KEYWORD, stun), (DOMAIN-KEYWORD, tracker), (DOMAIN-KEYWORD, p2p)))),REJECT

[Rewrite]

[Script]
request if ${url} ~= /^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$/i then script("https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.protobuf.request.js", {${logLevel}}) with enable=${sponsorBlock}, tag="空降助手", timeout=10, requires_body=true, binary_body_mode=true
request if ${url} ~= /^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$/i then script("https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.protobuf.request.js", {${purifyComment}, ${logLevel}}) with enable=${optimizeRequest}, tag="请求处理", timeout=10, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(app\.(show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|view(unite)?\.v1\.View\/(View|ViewProgress|RelatesFeed|AIRelateAsync)|playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|polymer\.app\.search\.v1\.Search\/SearchAll|community\.service\.dm\.v1\.DM\/DmView|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$/i then script("https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.protobuf.response.js", {${displayUpList}, ${purifyComment}, ${sponsorBlock}, ${logLevel}}) with tag="ProtoBuf处理", requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\?/i then script("https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.json.js") with tag="移除直播间广告", requires_body=true

[MITM]
hostname = grpc.biliapi.net, app.bilibili.com, api.bilibili.com, api.live.bilibili.com, line3-h5-mobile-api.biligame.com
