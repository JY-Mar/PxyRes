[Rewrite]
request if ${url} ~= /^https:\/\/hmbaby\.simshine\.cn\/admin\/filter\/advert\/getAdvertLists/i then reject_dict(200)
request if ${url} ~= /^https:\/\/hmbaby\.simshine\.cn\/admin\/filter\/crowdFunding\/getNewProductData/i then reject_dict(200)

[MITM]
hostname = hmbaby.simshine.cn
