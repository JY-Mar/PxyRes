#!name=哔哩哔哩去广告
#!desc=哔哩哔哩去广告
#!homepage=https://github.com/JY-Mar/PxyRes
#!author=ddgksf2013,JY-Mar
#!tag=BiliBili,哔哩哔哩,去广告
#!date=2026-10-26 16:40:34 GMT+8
#!icon=https://jy-mar.github.io/PxyRes/Icons/App/BiliBili.png
#!openUrl=https://apps.apple.com/app/id736536022
#!loon_version=3.5.1(978)

[Rewrite]
#～BiliBili_哔哩哔哩_屏蔽IP请求@ddgksf2013
request if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/ip/i then reject(404)
#～BiliBili_哔哩哔哩_屏蔽DefaultWord@ddgksf2013
request if ${url} ~= /^https?:\/\/app\.bilibili\.com\/bilibili\.app\.interface\.v1\.Search\/Default/i then reject(404)
#～BiliBili_哔哩哔哩_屏蔽首页右上活动[卸载重装]@ddgksf2013
request if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/top\/activity/i then reject_dict(200)
#～BiliBili_哔哩哔哩_应用开屏去广告@bm7
request if ${url} ~= /^https:\/\/app.bilibili.com\/x\/v2\/splash\/show/i then reject_dict(200)
#～BiliBili_哔哩哔哩_Defaultword@ddgksf2013
request if ${url} ~= /^https:\/\/app.bilibili.com\/x\/v2\/search\/defaultwords/i then reject_dict(200)
#～BiliBili_哔哩哔哩_Material_Ad@ddgksf2013
request if ${url} ~= /^https?:\/\/api\.bilibili\.com\/x\/vip\/ads\/material\/report/i then reject_dict(200)
#～BiliBili_哔哩哔哩_小卡片广告@ddgksf2013
request if ${url} ~= /^https:\/\/api.bilibili.com\/pgc\/season\/player\/cards/i then reject_dict(200)
#～BiliBili_哔哩哔哩_解除SIM卡地区限制
request if ${url} ~= /^(https:\/\/app\.biliintl\.com\/intl\/[^?]*)\?sim_code=\d+(\?|&)?(.*)$/ as m then redirect(302, "${m.1}")
#～BiliBili_哔哩哔哩_去除搜索中的大家都在搜@bm7
request if ${url} ~= /^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words/i then reject(404)
#～BiliBili_哔哩哔哩_去除动态中的话题@bm7
request if ${url} ~= /^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr/i then reject_dict(200)
#～BiliBili_哔哩哔哩_可能的一些推广(beta)@bm7
request if ${url} ~= /^https?:\/\/api\.bilibili\.com\/pgc\/season\/app\/related\/recommend\?/i then reject_dict(200)
#～BiliBili_哔哩哔哩_漫画去广告@ddgksf2013
request if ${url} ~= /^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/(Flash|ListFlash)/i then reject_dict(200)

[Script]
#～BiliBili_哔哩哔哩_繁体CC字幕转中文简体[自行启用]@ddgksf2013
response if ${url} ~= /^https?:\/\/i.\.hdslb\.com\/bfs\/subtitle\/.+\.json$/i then script("https://jy-mar.github.io/PxyScr/BiliBili/_Bilibili_CC.conf") with requires_body=true
#～BiliBili_哔哩哔哩_观影页面去广告@ddgksf2013
response if ${url} ~= /^https?:\/\/api\.(bilibili|biliapi)\.(com|net)\/pgc\/page\/cinema\/tab\?/i then script("https://jy-mar.github.io/PxyScr/BiliBili/_bilibili_json.js") with requires_body=true
#～BiliBili_哔哩哔哩_应用开屏广告预加载@yjqiang
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list/i then script("https://jy-mar.github.io/PxyScr/BiliBili/_bilibili_json.js") with requires_body=true
#～BiliBili_哔哩哔哩_去除统一设置的皮肤@ddgksf2013
response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\?/i then script("https://jy-mar.github.io/PxyScr/BiliBili/_bilibili_json.js") with requires_body=true
#～BiliBili_哔哩哔哩_1080P高码率+4K画质(番剧和影视除外)@ddgksf2013
response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\?/i then script("https://jy-mar.github.io/PxyScr/BiliBili/_bilibili_json.js") with requires_body=true
#～BiliBili_哔哩哔哩_热搜发现@ddgksf2013
response if ${url} ~= /^https:\/\/app.bilibili.com\/x\/v2\/search\/square/i then script("https://jy-mar.github.io/PxyScr/BiliBili/_bilibili_json.js") with requires_body=true
#～BiliBili_哔哩哔哩_推荐去广告@ddgksf2013
response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index/i then script("https://jy-mar.github.io/PxyScr/BiliBili/_bilibili_json.js") with requires_body=true
#～BiliBili_哔哩哔哩_追番去广告@ddgksf2013
response if ${url} ~= /^https?:\/\/api\.(bilibili|biliapi)\.(com|net)\/pgc\/page\/bangumi/i then script("https://jy-mar.github.io/PxyScr/BiliBili/_bilibili_json.js") with requires_body=true
#～BiliBili_哔哩哔哩_直播去广告@bm7
response if ${url} ~= /^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom/i then script("https://jy-mar.github.io/PxyScr/BiliBili/_bilibili_json.js") with requires_body=true
#～BiliBili_哔哩哔哩_动态去广告@bm7
response if ${url} ~= /^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/dynamic_(history|new)\?/i then script("https://jy-mar.github.io/PxyScr/BiliBili/_bilibili_json.js") with requires_body=true
#～BiliBili_哔哩哔哩_标籤页处理@ddgksf2013
response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/tab/i then script("https://jy-mar.github.io/PxyScr/BiliBili/_bilibili_json.js") with requires_body=true
#～BiliBili_哔哩哔哩_我的页面处理@ddgksf2013
response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/mine/i then script("https://jy-mar.github.io/PxyScr/BiliBili/_bilibili_json.js") with requires_body=true
#～BiliBili_哔哩哔哩_Proto去广告@app2smile
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/bilibili\.app\.(view\.v1\.View\/View|dynamic\.v2\.Dynamic\/DynAll)$/i then script("https://jy-mar.github.io/PxyScr/BiliBili/_bilibili-proto.js") with requires_body=true
#～BiliBili_哔哩哔哩_动态广告@yjqiang
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynAll$/i then script("https://jy-mar.github.io/PxyScr/BiliBili/_bilibili_dynamic.js") with requires_body=true

[MITM]
hostname = app.bilibili.com, app.biliintl.com, api.live.bilibili.com, api.vc.bilibili.com, api.bilibili.com, manga.bilibili.com, grpc.biliapi.net, api.biliapi.net, -broadcast.chat.bilibili.com, -*cdn*.biliapi.net, -*tracker*.biliapi.net
