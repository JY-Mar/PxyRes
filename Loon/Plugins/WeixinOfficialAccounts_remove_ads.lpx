#!name=微信公众号去广告
#!desc=过滤微信公众号广告
#!homepage=https://github.com/JY-Mar/PxyRes
#!author=RuCu6,ZeroM26,JY-Mar
#!tag=微信,微信公众号,Weixin,Wechat,去广告
#!date=2026-10-29 14:44:47 GMT+8
#!icon=https://jy-mar.github.io/PxyIco/App/WeChat.png
#!openUrl=https://apps.apple.com/app/id41448124
#!loon_version=3.5.1(978)

[Rule]
DOMAIN-SUFFIX,wxs.qq.com,REJECT

[Rewrite]
# 移除公众号中的推广内容 //mp.weixin.qq.com
request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|getappmsgad|jsmonitor|masonryfeed|relatedarticle)\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword/i then reject_dict(200)

# [Script]

[MITM]
hostname = mp.weixin.qq.com
