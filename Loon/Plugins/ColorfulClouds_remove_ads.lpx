#!name=彩云天气去广告+
#!desc=移除首页推广、弹窗、悬浮窗、底栏天气助手、和工具箱入口，移除我的页面广告横幅
#!homepage=https://github.com/JY-Mar/PxyRes
#!author=Mixed,ddgksf2013,可莉🅥,RuCu6,JY-Mar
#!tag=彩云天气,去广告
#!date=2026-10-29 14:45:39 GMT+8
#!icon=https://jy-mar.github.io/PxyIco/App/ColorfulCloudsPro.png
#!openUrl=https://apps.apple.com/app/id1067198688
#!loon_version=3.5.1(978)

[Rule]
DOMAIN,abyss.cyapi.cn,REJECT
DOMAIN,ad.cyapi.cn,REJECT
DOMAIN,gather.colorfulclouds.net,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/ad\.cyapi\.cn\/v\d/i then reject(200)
request if ${url} ~= /^https:\/\/biz\.cyapi\.cn\/(p\/v1\/entries|p\/v1\/trial_card\/info|v2\/product)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/starplucker\.cyapi\.cn\/v3\/(config\/cypage\/\w+\/conditions|notification\/message_center|operation\/homefeatures)/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/biz\.cyapi\.cn\/api\/v\d\/user_detail/i then script("https://jy-mar.github.io/PxyScr/ColorfulClouds/remove_ads.js") with tag="移除用户详细信息", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/biz\.cyapi\.cn\/v\d\/user/i then script("https://jy-mar.github.io/PxyScr/ColorfulClouds/remove_ads.js") with tag="改写用户信息", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/wrapper\.cyapi\.cn\/v\d\/activity/i then script("https://jy-mar.github.io/PxyScr/ColorfulClouds/remove_ads.js") with tag="去广告", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/api\.caiyunapp\.com\/v\d\/activity/i then script("https://jy-mar.github.io/PxyScr/ColorfulClouds/remove_ads.js") with tag="移除AI助手", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/operation\/homefeatures/i then script("https://jy-mar.github.io/PxyScr/ColorfulClouds/remove_ads.js") with tag="移除APP内部消息", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/notification\/message_center/i then script("https://jy-mar.github.io/PxyScr/ColorfulClouds/remove_ads.js") with tag="移除工具箱", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/config\/cypage/i then script("https://jy-mar.github.io/PxyScr/ColorfulClouds/remove_ads.js") with tag="移除弹窗广告", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/operation\/feeds/i then script("https://jy-mar.github.io/PxyScr/ColorfulClouds/remove_ads.js") with tag="移除工具箱", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/operation\/banners/i then script("https://jy-mar.github.io/PxyScr/ColorfulClouds/remove_ads.js") with tag="移除Banner", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/operation\/features/i then script("https://jy-mar.github.io/PxyScr/ColorfulClouds/remove_ads.js") with tag="移除工具箱", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/campaigns/i then script("https://jy-mar.github.io/PxyScr/ColorfulClouds/remove_ads.js") with tag="移除推广信息", timeout=20, requires_body=true

[MITM]
hostname = biz.cyapi.cn, starplucker.cyapi.cn, ad.cyapi.cn, api.caiyunapp.com, cdn-w.caiyunapp.com, wrapper.cyapi.cn
